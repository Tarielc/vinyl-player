# Copy to .env.local and fill in. Providers without credentials show as unavailable.

# Random string, 32+ chars. Encrypts the provider session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public base URL; OAuth redirect URIs are built from it.
# Spotify rejects "localhost" — use 127.0.0.1 locally and open the app at this URL.
APP_URL=http://127.0.0.1:3000

# Spotify — https://developer.spotify.com/dashboard
# Redirect URI to register: http://127.0.0.1:3000/api/music/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 key (search) — Google Cloud console > APIs & Services > Credentials
YOUTUBE_API_KEY=

# Google OAuth client (optional; for YouTube playlists / liked videos). Type: Web application.
# Redirect URI to register: http://127.0.0.1:3000/api/music/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: your 2-letter country code (e.g. US, GB, DE). YouTube results that
# are blocked in this region are hidden. Leave empty to skip region filtering.
YOUTUBE_REGION=
